digraph DER {
  graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.65", ranksep="0.85", fontname="Arial", label="Diagrama Entidade-Relacionamento — Biblioteca Digital", labelloc="t", fontsize=20];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=10, color="#64748b", penwidth=1.5];

  livros [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c7d2fe">
      <TR><TD BGCOLOR="#4f46e5" COLSPAN="3"><FONT COLOR="white"><B>LIVROS</B></FONT></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INTEGER</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">titulo</TD><TD ALIGN="LEFT">VARCHAR(200)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">autor</TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">ano_publicacao</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">copias_total</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">copias_disponiveis</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
    </TABLE>
  >];

  usuarios [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#bfdbfe">
      <TR><TD BGCOLOR="#2563eb" COLSPAN="3"><FONT COLOR="white"><B>USUARIOS</B></FONT></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INTEGER</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR>
      <TR><TD><B>UK</B></TD><TD ALIGN="LEFT">identificacao</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">contato</TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR>
    </TABLE>
  >];

  emprestimos [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#ddd6fe">
      <TR><TD BGCOLOR="#7c3aed" COLSPAN="3"><FONT COLOR="white"><B>EMPRESTIMOS</B></FONT></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INTEGER</TD></TR>
      <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">livro_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
      <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">data_emprestimo</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">data_devolucao</TD><TD ALIGN="LEFT">DATETIME NULL</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
    </TABLE>
  >];

  livros -> emprestimos [label=" 1   possui   0..N ", arrowhead="crow", arrowtail="tee", dir="both"];
  usuarios -> emprestimos [label=" 1   realiza   0..N ", arrowhead="crow", arrowtail="tee", dir="both"];
}
